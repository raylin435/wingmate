# Copy to .env and fill in what you have. Every key is optional: without it, Wingmate uses a local fallback.
SIE_API_KEY=                # Superlinked SIE Serverless (console.superlinked.com)
SINGLESTORE_URL=            # singlestoredb://user:password@host:3306/dbname
STATSIG_SERVER_KEY=         # secret-...
AMPLITUDE_API_KEY=
LLM_API_KEY=                # enables Cognee memory graph (Cognee's LLM provider key)
COGNEE_ENABLED=auto         # auto | 1 | 0
# Optional model overrides
# SIE_CHAT_MODEL=Qwen/Qwen3.8-27B-FP8
# SIE_EMBED_MODEL=Qwen/Qwen3-Embedding-4B
# SIE_RERANK_MODEL=Qwen/Qwen3-Reranker-4B
