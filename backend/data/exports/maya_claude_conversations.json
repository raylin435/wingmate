  {
    "uuid": "789f1108-f7b8-5994-ba9e-2d8c4a9396b8",
    "name": "Dating after a breakup",
    "created_at": "2026-03-06T06:13:20.000000Z",
    "updated_at": "2026-03-06T06:14:20.000000Z",
    "chat_messages": [
      {
        "uuid": "0cd2209d-502a-5961-ad6d-3591875a67c9",
        "sender": "human",
        "text": "I'm ready to date again but nervous. I want someone curious and outdoorsy who would happily split a plate of dumplings and doesn't smoke.",
        "created_at": "2026-03-06T06:13:35.000000Z"
      },
      {
        "uuid": "b495ebd0-ecd5-50da-a2c8-d5e1b7e306dc",
        "sender": "assistant",
        "text": "That is a clear picture. What does a good first date feel like for you?",
        "created_at": "2026-03-06T06:13:55.000000Z"
      },
      {
        "uuid": "d622ee87-043a-5f7a-9c37-6779ffb4f7ad",
        "sender": "human",
        "text": "Daytime, low pressure, with a walk. And my dog Biscuit can come along if it's outdoors.",
        "created_at": "2026-03-06T06:14:20.000000Z"
      }
    ]
  },
  {
