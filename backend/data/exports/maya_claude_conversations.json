    "uuid": "0a8bae46-3dab-5a1b-b91a-3bb61ad3c7c3",
    "name": "Pottery glaze questions",
    "created_at": "2026-04-11T06:13:20.000000Z",
    "updated_at": "2026-04-11T06:13:55.000000Z",
    "chat_messages": [
      {
        "uuid": "eab31204-203a-5652-aefd-b13f65e20510",
        "sender": "human",
        "text": "I'm taking a beginner pottery class. What's the difference between underglaze and glaze?",
        "created_at": "2026-04-11T06:13:35.000000Z"
      },
      {
        "uuid": "a32a7ec0-f769-5a64-bc28-9b6e5d5c9e91",
        "sender": "assistant",
        "text": "Underglaze is for color and decoration under a clear glaze, while glaze creates the final glassy surface.",
        "created_at": "2026-04-11T06:13:55.000000Z"
      }
    ]
  },
  {
    "uuid": "a09adbe6-ee64-55f7-af4a-437f27d51854",
    "name": "Budget for a bay area move",
    "created_at": "2026-04-20T06:13:20.000000Z",
    "updated_at": "2026-04-20T06:13:55.000000Z",
    "chat_messages": [
      {
        "uuid": "56f33c1f-fa62-5a00-bcf9-77e18c1838e0",
        "sender": "human",
        "text": "Estimate monthly costs if I move from the Inner Sunset to a one-bedroom in the Richmond.",
        "created_at": "2026-04-20T06:13:35.000000Z"
      },
      {
        "uuid": "14e696ac-ecc9-5264-b0dd-8c716d40cfbb",
        "sender": "assistant",
        "text": "Rent is similar. Factor in moving costs, deposits, and utilities of about 150 to 200 per month.",
        "created_at": "2026-04-20T06:13:55.000000Z"
      }
    ]
  },
  {
    "uuid": "16b6d7f4-0fc9-5562-b70e-d686f8acf8ec",
    "name": "Talking about kids on a first date",
    "created_at": "2026-04-29T06:13:20.000000Z",
    "updated_at": "2026-04-29T06:14:20.000000Z",
    "chat_messages": [
      {
        "uuid": "6390e1f9-d717-5608-be12-168ad3e215b9",
        "sender": "human",
        "text": "How do I bring up kids on a first date when I honestly don't know what I want?",
        "created_at": "2026-04-29T06:13:35.000000Z"
      },
      {
        "uuid": "1cfcfad4-eb33-532a-b6ea-cac049bc4e3e",
        "sender": "assistant",
        "text": "Be honest: I'm open but unsure, and I would like to explore it with the right person.",
        "created_at": "2026-04-29T06:13:55.000000Z"
      },
      {
        "uuid": "244fc612-be8e-5fa6-b89d-0add8208902a",
        "sender": "human",
        "text": "That feels right. I don't want to pretend to be certain.",
        "created_at": "2026-04-29T06:14:20.000000Z"
      }
    ]
  }
]
